{
  "name": "neighshop-marketplace-backend",
  "version": "1.0.0",
  "description": "Shared REST API backend for NeighShop Global OLX-inspired Classified Marketplace",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "prod": "node dist/server.js",
    "test:m3": "tsx scripts/verify-milestone3.ts",
    "test:m4": "tsx scripts/verify-milestone4.ts",
    "test:m5": "tsx scripts/verify-milestone5.ts",
    "test:m6": "tsx scripts/verify-milestone6.ts",
    "test:m7": "tsx scripts/verify-milestone7.ts",
    "test:e2e": "tsx scripts/verify-e2e.ts",
    "test:db": "tsx scripts/verify-database.ts",
    "test": "npm run test:db && npm run test:m3 && npm run test:m4 && npm run test:m5 && npm run test:m6 && npm run test:m7"
  },
  "keywords": [
    "olx",
    "marketplace",
    "classifieds",
    "express",
    "mysql",
    "rest-api",
    "typescript"
  ],
  "author": "Vansh",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
