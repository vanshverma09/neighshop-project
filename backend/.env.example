# Server Configuration
PORT=5000
NODE_ENV=production
API_BASE_URL=https://neighshop-api.onrender.com

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_64_char_string_for_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or * for open access)
CORS_ORIGIN=https://neighshop-admin.vercel.app,http://localhost:5173,*

# Managed Cloud MySQL Configuration (e.g., Aiven, Railway, AWS RDS)
# Option A: Single Connection URI (Recommended for cloud providers)
DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-xxxx-neighshop.aivencloud.com:11893/defaultdb?ssl-mode=REQUIRED

# Option B: Discrete Parameters
# DB_CLIENT=mysql
# DB_HOST=mysql-xxxx-neighshop.aivencloud.com
# DB_PORT=11893
# DB_USER=avnadmin
# DB_PASSWORD=YOUR_PASSWORD
# DB_NAME=defaultdb

# Persistent Image Storage (Cloudinary CDN - 100% Free 25GB tier)
# Get from https://cloudinary.com console
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Or:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Fallback Local SQLite Storage (Used automatically if MySQL is unreachable)
SQLITE_DB_PATH=./database/marketplace.sqlite
